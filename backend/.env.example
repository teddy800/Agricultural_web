# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://agri:CHANGE_THIS_LOCAL_PASSWORD@localhost:5432/agriconnect

# Optional: For production deployment
# DATABASE_URL=postgresql://user:pass@production-host:5432/agriconnect

# CORS Configuration (comma-separated URLs)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT Secret (for future authentication implementation)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads

# API Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Email Configuration (for future implementation)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Weather API (for future integration)
WEATHER_API_KEY=your_weather_api_key

# SMS Configuration (for future implementation)
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=AgriConnect
